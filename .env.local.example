# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — SERVER-ONLY, never expose to the browser.
# Used for privileged actions like a parent/admin creating a child's login.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
